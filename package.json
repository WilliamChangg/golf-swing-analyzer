{
  "name": "golf-swing-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first golf swing biomechanics analyzer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gsa/desktop",
    "dev:web": "npm run dev:web -w @gsa/desktop",
    "build": "npm run build -w @gsa/desktop",
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:types": "uv run --project python python scripts/gen_types.py",
    "gen:types:check": "uv run --project python python scripts/gen_types.py --check",
    "doctor": "uv run --project python analyzer doctor",
    "py:test": "uv run --project python pytest",
    "py:coverage": "uv run --project python pytest python/tests --cov --cov-config=python/pyproject.toml --cov-report=term-missing:skip-covered --cov-report=xml:coverage/python/coverage.xml --cov-report=html:coverage/python/html",
    "py:lint": "uv run --project python ruff check python && uv run --project python ruff format --check python",
    "py:typecheck": "uv run --project python mypy python/analyzer",
    "rs:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
    "rs:lint": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rs:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "check:all": "npm run lint && npm run typecheck && npm run test && npm run py:lint && npm run py:typecheck && npm run py:test && npm run rs:fmt && npm run rs:lint",
    "docs:generate": "python3 scripts/document_benchmarks.py",
    "docs:check": "python3 scripts/document_benchmarks.py --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
