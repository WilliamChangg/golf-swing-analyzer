# Lockfiles
uv.lock       -diff linguist-generated=true
package-lock.json -diff linguist-generated=true
apps/desktop/src-tauri/Cargo.lock -diff linguist-generated=true

# Binary assets
*.task  binary
*.onnx  binary
*.pt    binary
*.mp4   binary
*.mov   binary
*.parquet binary
